# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by route handlers for token-scoped writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kyc.easemyoffice.in
# Secret the CRM must send to create KYC cases (POST /api/cases)
CRM_WEBHOOK_SECRET=change-me

# Salt used to hash Aadhaar for duplicate detection. NEVER store raw Aadhaar.
AADHAAR_HASH_SALT=change-me-long-random

# ── Provider selection (adapters) ─────────────────────────
# mock = local/dev stub. Swap to the real provider once credentials are ready.
AADHAAR_PROVIDER=mock          # mock | digilocker
VIDEO_KYC_PROVIDER=mock        # mock | <vendor>
PAN_PROVIDER=mock              # mock | <vendor>
NOTIFICATION_PROVIDER=resend   # mock | resend

# ── DigiLocker (Meri Pehchaan Partner API) ────────────────
# TODO: plug in vendor — fill once onboarded as a DigiLocker partner or via aggregator
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://kyc.easemyoffice.in/api/cases/callback/digilocker
DIGILOCKER_AUTH_BASE=https://api.digitallocker.gov.in

# ── Video KYC vendor (optional, later) ────────────────────
VIDEO_KYC_API_KEY=
VIDEO_KYC_API_BASE=

# ── Notifications: Resend (email) ─────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sender on your Resend domain (must be a domain you've verified in Resend).
NOTIFY_EMAIL_FROM=EaseMyOffice KYC <kyc@easemyoffice.in>
# Internal mailbox that receives an alert every time a client submits a KYC.
OPS_NOTIFY_EMAIL=kyc@easemyoffice.in

# WhatsApp (optional, later)
WHATSAPP_API_KEY=
