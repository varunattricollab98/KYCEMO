# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by route handlers for
# token-scoped writes and signed storage URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kyc.easemyoffice.in
# Secret the CRM must send to pre-create KYC cases (optional; POST /api/cases)
CRM_WEBHOOK_SECRET=change-me

# ── Notifications: Resend (email) ─────────────────────────
NOTIFICATION_PROVIDER=resend   # mock | resend
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sender on your Resend domain (domain must be verified in Resend).
NOTIFY_EMAIL_FROM=EaseMyOffice KYC <kyc@easemyoffice.in>
# Documentation team mailbox that receives every KYC submission (formatted
# details + secure download links for the Aadhaar/PAN images and the video).
OPS_NOTIFY_EMAIL=team@easemyoffice.in
